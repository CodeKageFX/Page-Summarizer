{
    "manifest_version": 3,
    "name": "Summarize",
    "version": "1.0",
    "description": "AI-powered page summarizer",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "http://localhost:4000/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}